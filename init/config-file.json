{
    "name": "hw-python",
    "version": "1.0.0",
    "containers": [
        {
            "name": "hw-python",
            "image": {
                "registry": "127.0.0.1:5001",
                "name": "hw-python",
                "tag": "1.0.0"
            }
        }
    ],
    "messaging": {
        "ports": [
            {
                "name": "http",
                "container": "hw-python",
                "port": 8080,
                "description": "http service"
            },
            {
                "name": "rmrroute",
                "container": "hw-python",
                "port": 4561,
                "description": "rmr route port for hw-python xapp"
            },
            {
                "name": "rmrdata",
                "container": "hw-python",
                "port": 4560,
                "rxMessages": ["RIC_SUB_RESP", "RIC_SUB_FAILURE", "RIC_SUB_DEL_RESP", "A1_POLICY_REQ", "RIC_INDICATION", "RIC_CONTROL_ACK", "RIC_CONTROL_FAILURE"],
                "txMessages": ["RIC_SUB_REQ", "RIC_SUB_DEL_REQ", "A1_POLICY_RESP", "A1_POLICY_QUERY", "RIC_HEALTH_CHECK_RESP", "RIC_CONTROL_REQ"],
                "policies": [1],
                "description": "rmr data port for hw-python"
            }
        ]
    },
    "rmr": {
        "protPort": "tcp:4560",
        "maxSize": 2072,
        "numWorkers": 1,
        "rxMessages": ["RIC_SUB_RESP", "RIC_SUB_FAILURE", "RIC_SUB_DEL_RESP", "A1_POLICY_REQ", "RIC_INDICATION", "RIC_CONTROL_ACK", "RIC_CONTROL_FAILURE"],
        "txMessages": ["RIC_SUB_REQ", "RIC_SUB_DEL_REQ", "A1_POLICY_RESP", "A1_POLICY_QUERY", "RIC_HEALTH_CHECK_RESP", "RIC_CONTROL_REQ"],
        "policies": [1]
    },
    "controls": {
        "fileStrorage": false
    },
    "db" : {
        "waitForSdl": false
    }
}
